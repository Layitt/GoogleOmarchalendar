{
  "schemaVersion": 1,
  "id": "layitt.google-omarchalendar",
  "name": "Google Omarchalendar",
  "version": "1.0.0",
  "author": "Layitt",
  "license": "MIT",
  "description": "Google Calendar widget with interactive event management, official color picker, hyper-local weather forecast, and bilingual Spanish/English localization.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Calendario & Clima",
    "description": "Tu calendario de Google en la barra con gestión de eventos (añadir, editar, borrar), selección de colores oficiales, pronóstico del clima y soporte completo en español.",
    "category": "Time",
    "allowMultiple": false,
    "defaults": {
      "format": "dddd HH:mm",
      "formatAlt": "d MMMM 'W'ww yyyy",
      "verticalFormat": "HH\n-\nmm"
    },
    "schema": [
      {
        "key": "format",
        "type": "string",
        "label": "Date format",
        "defaultValue": "dddd HH:mm"
      },
      {
        "key": "formatAlt",
        "type": "string",
        "label": "Alternate format",
        "defaultValue": "d MMMM 'W'ww yyyy"
      },
      {
        "key": "verticalFormat",
        "type": "string",
        "label": "Vertical bar format",
        "defaultValue": "HH\n-\nmm"
      },
      {
        "key": "birthYear",
        "type": "number",
        "label": "Birth year",
        "defaultValue": 0
      },
      {
        "key": "lifeExpectancy",
        "type": "number",
        "label": "Life expectancy",
        "defaultValue": 0
      },
      {
        "key": "language",
        "type": "string",
        "label": "Language / Idioma (es/en)",
        "defaultValue": "es"
      },
      {
        "key": "weatherLocation",
        "type": "string",
        "label": "Weather location",
        "defaultValue": ""
      }
    ]
  }
}
